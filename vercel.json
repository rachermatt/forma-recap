{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{demo/**,server/media/**}",
      "excludeFiles": "{.env,.env.*,data/**,work/**,docs/**,examples/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__forma_route=/api/:path*" },
    { "source": "/auth/:path*", "destination": "/api/index?__forma_route=/auth/:path*" }
  ]
}
